# Target Chip
CONFIG_IDF_TARGET="esp32s3"

# Flash settings (8MB as per your config)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_OPI=y
CONFIG_ESPTOOLPY_OCT_FLASH=y

# PSRAM Settings for N16R8 (Octal RAM)
CONFIG_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESP32S3_OCTAL=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# CPU and Cache
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# Squeezelite Features
CONFIG_SQUEEZELITE_ADC_IN=y
CONFIG_EQUALIZER=y
CONFIG_AIRPLAY_SINK=y
CONFIG_CSPOT_SINK=y

# Audio I/O Defaults
CONFIG_I2S_NUM=0
CONFIG_I2S_BCK_IO=12
CONFIG_I2S_WS_IO=13
CONFIG_I2S_DO_IO=45
CONFIG_I2S_DI_IO=11

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
